# --- Zero-credential demo --------------------------------------------------
# Set DEMO_MODE=1 to run everything in-process: embedded ClickHouse (chdb),
# seeded telemetry, and rule-based reasoning fallbacks. Clearly labelled in the
# UI. Leave unset for the real thing.
# DEMO_MODE=1
# DEMO_ROWS=250000
# DEMO_SCENARIO=shield_eviction
# DEMO_SEED=0                 # pins the generated dataset, for reproducing a run

# --- Google Cloud / Gemini -------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash
# For local dev without Vertex, set GOOGLE_GENAI_USE_VERTEXAI=FALSE and:
# GOOGLE_API_KEY=

# --- ClickHouse Cloud ------------------------------------------------------
CLICKHOUSE_HOST=xxxxx.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true

# --- Detection tuning ------------------------------------------------------
INCIDENT_WINDOW_MIN=20
BASELINE_MIN=180
Z_THRESHOLD=2.0
ARPU_PER_VIEWER_HOUR_USD=0.42

# --- Optional: real frames from your packager ------------------------------
# THUMBNAIL_BASE_URL=https://thumbs.example-cdn.net/live
